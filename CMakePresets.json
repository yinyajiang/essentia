{
  "version": 3,
  "configurePresets": [
    {
      "name": "macOS-preset",
      "binaryDir": "build",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/installed",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "FFTW3f_DIR": "${sourceDir}/packaging/macos/fftw3f/lib/cmake/fftw3f",
        "Eigen3_DIR": "${sourceDir}/packaging/macos/eigen/share/eigen3/cmake/Eigen3",
        "SampleRate_DIR": "${sourceDir}/packaging/macos/libsamplerate/lib/cmake/SampleRate"
      },
      "environment": {
        "PKG_CONFIG_PATH": "/Volumes/extern-usb/MMProject/vocalremover/sondkits/3rd/ffmpeg-mac/lib/pkgconfig"
      }
    },
    {
      "name": "macOS-arm-preset",
      "binaryDir": "build",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/installed",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "FFTW3f_DIR": "${sourceDir}/packaging/macos_arm/fftw3f/lib/cmake/fftw3f",
        "Eigen3_DIR": "${sourceDir}/packaging/macos_arm/eigen/share/eigen3/cmake/Eigen3",
        "SampleRate_DIR": "${sourceDir}/packaging/macos_arm/libsamplerate/lib/cmake/SampleRate"
      },
      "environment": {
        "PKG_CONFIG_PATH": "/Volumes/extern-usb/MMProject/vocalremover/sondkits/3rd/ffmpeg-mac/lib/pkgconfig"
      }
    },
    {
      "name": "windows-preset",
      "binaryDir": "build",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/installed",
        "CMAKE_PREFIX_PATH": "${sourceDir}/packaging/msvc"
      },
      "environment": {
        "PATH": "${sourceDir}/packaging/msvc/bin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-macOS",
      "configurePreset": "macOS-preset",
      "targets": [
        "install"
      ]
    },
    {
      "name": "build-macOS-arm",
      "configurePreset": "macOS-arm-preset",
      "targets": [
        "install"
      ]
    },
    {
      "name": "build-windows",
      "configurePreset": "windows-preset",
      "targets": [
        "install"
      ]
    }
  ]
}